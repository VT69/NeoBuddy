#!/bin/bash
# First boot of the NeoBuddy instance: Docker, the compose plugin, swap and the infrastructure
# settings the deploy scripts read. Everything else arrives with the first deploy.
set -euxo pipefail

dnf -y install docker jq
systemctl enable --now docker

# Docker Compose plugin, pinned and checksum-verified (Amazon Linux does not package it).
arch="$(uname -m)"
case "$arch" in
  aarch64) sha256="${compose_sha256.aarch64}" ;;
  x86_64) sha256="${compose_sha256.x86_64}" ;;
  *) echo "unsupported architecture $arch" >&2; exit 1 ;;
esac
curl -fsSL -o /tmp/docker-compose \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-$arch"
echo "$sha256  /tmp/docker-compose" | sha256sum -c -
install -D -m 755 /tmp/docker-compose /usr/libexec/docker/cli-plugins/docker-compose
rm -f /tmp/docker-compose
docker compose version

# 1 GB of swap: headroom for the JVM, PostgreSQL and Caddy sharing 2 GB of memory.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi
swapon -a

install -d -m 700 /etc/neobuddy
install -d -m 755 /opt/neobuddy
cat > /etc/neobuddy/infra.env <<'INFRA'
AWS_REGION=${region}
LOG_GROUP=${log_group}
BACKUP_BUCKET=${backup_bucket}
ECR_REGISTRY=${ecr_registry}
SSM_PATH=${ssm_path}
INFRA
chmod 600 /etc/neobuddy/infra.env
