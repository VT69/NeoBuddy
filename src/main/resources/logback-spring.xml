<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging. Locally and in tests: Spring Boot's usual console format. With the "prod" profile (set
  by deploy/docker-compose.prod.yml): one JSON object per line on stdout, which Docker's awslogs
  driver ships to CloudWatch. Each line carries the MDC fields, in particular rfcMessageId (the
  correlation id) and collegeSlug, and "event" for lines CloudWatch counts (DeliveryDead).

  Never log email bodies, attachment content, other students' identifiers, tokens or secrets.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdcKeyName>rfcMessageId</includeMdcKeyName>
        <includeMdcKeyName>collegeSlug</includeMdcKeyName>
        <includeMdcKeyName>event</includeMdcKeyName>
        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
          <maxDepthPerThrowable>30</maxDepthPerThrowable>
          <rootCauseFirst>true</rootCauseFirst>
        </throwableConverter>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>

  <springProfile name="!prod">
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>
</configuration>
